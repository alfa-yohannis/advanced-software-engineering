<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>mediaflow.antlr</groupId>
	<artifactId>mediaflow.antlr</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<build>
		<sourceDirectory>src</sourceDirectory>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.13.0</version>
				<configuration>
					<release>17</release>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.antlr</groupId>
				<artifactId>antlr4-maven-plugin</artifactId>
				<version>4.13.2</version>
				<!-- Without this execution the plugin never runs, and the parser
				     checked into src/ stays at whatever ANTLR version generated
				     it. A 4.4 parser against the 4.13.2 runtime fails with
				     "Could not deserialize ATN with version 3 (expected 4)". -->
				<executions>
					<execution>
						<id>generate-parser</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>antlr4</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<sourceDirectory>${project.basedir}/antlr</sourceDirectory>
					<includes>
						<include>MediaFlow.g4</include>
					</includes>
					<visitor>true</visitor>
					<listener>true</listener>
					<arguments>
						<argument>-package</argument>
						<argument>yohannis.alfa.mediaflow.antlr.generated</argument>
					</arguments>
					<outputDirectory>${project.basedir}/src/yohannis/alfa/mediaflow/antlr/generated</outputDirectory>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<mainClass>yohannis.alfa.mediaflow.antlr.Main</mainClass>
					<!-- exec:java runs in Maven's own JVM, so it keeps the directory
					     Maven was started in. Pass an absolute path so the command
					     works from the project folder and from session-09. Override
					     it with -Dexec.args=<file>. -->
					<arguments>
						<argument>${project.basedir}/input/test.mediaflow</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>org.antlr</groupId>
			<artifactId>antlr4-runtime</artifactId>
			<version>4.13.2</version>
		</dependency>
	</dependencies>
</project>
