    <node xmi:type="uml:InitialNode" xmi:id="_pZx2ADZkEfGRxv3od1pGSw" name="inputVideo" outgoing="_pZ05UDZkEfGRxv3od1pGSw"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="_pZydEDZkEfGRxv3od1pGSw" name="outputVideo1" incoming="_pZ05UzZkEfGRxv3od1pGSw"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="_pZydETZkEfGRxv3od1pGSw" name="outputVideo2" incoming="_pZ05VDZkEfGRxv3od1pGSw"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="_pZzrMDZkEfGRxv3od1pGSw" name="resize720" incoming="_pZ05UDZkEfGRxv3od1pGSw" outgoing="_pZ05UTZkEfGRxv3od1pGSw _pZ05UjZkEfGRxv3od1pGSw">
      <language>shell</language>
      <body>ffmpeg -i input.mp4 -vf scale=1280:720 
      scaled.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="_pZzrMTZkEfGRxv3od1pGSw" name="encodeH264" incoming="_pZ05UTZkEfGRxv3od1pGSw" outgoing="_pZ05UzZkEfGRxv3od1pGSw">
      <language>shell</language>
      <body>ffmpeg -i scaled.mp4 -c:v libx264 -c:a aac output-h264.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="_pZzrMjZkEfGRxv3od1pGSw" name="encodeVp9" incoming="_pZ05UjZkEfGRxv3od1pGSw" outgoing="_pZ05VDZkEfGRxv3od1pGSw">
      <language>shell</language>
      <body>gst-launch-1.0 filesrc location=scaled.mp4 ! decodebin ! vp9enc bitrate=2500 ! webmmux ! filesink location=output-vp9.webm</body>
    </node>
