    <edge xmi:type="uml:ControlFlow" xmi:id="__yGPJOP4EfGjkJtVDhDoGQ" name="e5" target="__x5a0OP4EfGjkJtVDhDoGQ" source="__yFBAeP4EfGjkJtVDhDoGQ"/>
    <node xmi:type="uml:InitialNode" xmi:id="__xkDoeP4EfGjkJtVDhDoGQ" name="inputVideo" outgoing="__yGPIOP4EfGjkJtVDhDoGQ"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="__x4MsOP4EfGjkJtVDhDoGQ" name="outputVideo1" incoming="__yGPI-P4EfGjkJtVDhDoGQ"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="__x5a0OP4EfGjkJtVDhDoGQ" name="outputVideo2" incoming="__yGPJOP4EfGjkJtVDhDoGQ"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="__yEZ8OP4EfGjkJtVDhDoGQ" name="resize720" incoming="__yGPIOP4EfGjkJtVDhDoGQ" outgoing="__yGPIeP4EfGjkJtVDhDoGQ __yGPIuP4EfGjkJtVDhDoGQ">
      <language>shell</language>
      <body>ffmpeg -i input.mp4 -vf scale=1280:720 
      scaled.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="__yFBAOP4EfGjkJtVDhDoGQ" name="encodeH264" incoming="__yGPIeP4EfGjkJtVDhDoGQ" outgoing="__yGPI-P4EfGjkJtVDhDoGQ">
      <language>shell</language>
      <body>ffmpeg -i scaled.mp4 -c:v libx264 -c:a aac output-h264.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="__yFBAeP4EfGjkJtVDhDoGQ" name="encodeVp9" incoming="__yGPIuP4EfGjkJtVDhDoGQ" outgoing="__yGPJOP4EfGjkJtVDhDoGQ">
      <language>shell</language>
      <body>gst-launch-1.0 filesrc location=scaled.mp4 ! decodebin ! vp9enc bitrate=2500 ! webmmux ! filesink location=output-vp9.webm</body>
    </node>
