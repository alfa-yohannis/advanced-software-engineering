    <node xmi:type="uml:ActivityFinalNode" xmi:id="_kvgRgDZfEfGzQse_Mr7DCA" name="outputVideo1" incoming="_kvhfpjZfEfGzQse_Mr7DCA"/>
    <node xmi:type="uml:ActivityFinalNode" xmi:id="_kvgRgTZfEfGzQse_Mr7DCA" name="outputVideo2" incoming="_kvhfpzZfEfGzQse_Mr7DCA"/>
    <node xmi:type="uml:OpaqueAction" xmi:id="_kvhfoDZfEfGzQse_Mr7DCA" name="resize720" incoming="_kvhfozZfEfGzQse_Mr7DCA" outgoing="_kvhfpDZfEfGzQse_Mr7DCA _kvhfpTZfEfGzQse_Mr7DCA">
      <language>shell</language>
      <body>ffmpeg -i input.mp4 -vf scale=1280:720 
      scaled.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="_kvhfoTZfEfGzQse_Mr7DCA" name="encodeH264" incoming="_kvhfpDZfEfGzQse_Mr7DCA" outgoing="_kvhfpjZfEfGzQse_Mr7DCA">
      <language>shell</language>
      <body>ffmpeg -i scaled.mp4 -c:v libx264 -c:a aac output-h264.mp4</body>
    </node>
    <node xmi:type="uml:OpaqueAction" xmi:id="_kvhfojZfEfGzQse_Mr7DCA" name="encodeVp9" incoming="_kvhfpTZfEfGzQse_Mr7DCA" outgoing="_kvhfpzZfEfGzQse_Mr7DCA">
      <language>shell</language>
      <body>gst-launch-1.0 filesrc location=scaled.mp4 ! decodebin ! vp9enc bitrate=2500 ! webmmux ! filesink location=output-vp9.webm</body>
