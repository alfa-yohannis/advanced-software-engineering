<?xml version="1.0" encoding="ASCII"?>
<mediaflow:Graph xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:mediaflow="mediaflow" name="brokenDirection">
  <nodes xsi:type="mediaflow:Resource" name="inputVideo" uri="file:///home/alfa/videos/input.mp4" external="true">
    <ports name="inputOut" direction="OUT"/>
  </nodes>
  <nodes xsi:type="mediaflow:Scaler" name="resize720" command="" replicas="0" width="0" height="720">
    <ports name="resizeIn" direction="IN"/>
    <ports name="resizeOut" direction="OUT"/>
  </nodes>
  <nodes xsi:type="mediaflow:Resource" name="outputVideo" uri="" external="true">
    <ports name="outputIn" direction="IN"/>
  </nodes>
  <edges name="e1" source="//@nodes.0/@ports.0" target="//@nodes.1/@ports.0"/>
  <edges name="e2" source="//@nodes.2/@ports.0" target="//@nodes.1/@ports.1"/>
</mediaflow:Graph>
